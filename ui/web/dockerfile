ARG BUILD_IMAGE=golang:1.26.9-alpine
FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY go.mod ./
COPY *.go ./
COPY app/static ./app/static
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -buildid= -X main.version=${VERSION}" -o /out/awg_web .

FROM scratch
ARG VERSION=dev
LABEL org.opencontainers.image.title="awg-vps-control web" \
      org.opencontainers.image.source="https://github.com/khorevaa/awg-vps-control" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.awg-vps-control.component="web"
COPY --from=build /out/awg_web /usr/local/bin/awg_web
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=8s --start-period=10s --retries=3 CMD ["/usr/local/bin/awg_web", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/awg_web"]
