### Завершение сессии
POST {{base_url}}/api/v1/auth/logout
Origin: {{origin}}
X-CSRF-Token: {{csrf_token}}

> {%
client.test("Выход", function () {
    client.assert(response.status === 200, "статус ответа на запрос не 200");
});
client.global.clear("csrf_token");
%}
