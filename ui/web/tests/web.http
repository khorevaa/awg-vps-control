### Задайте base_url, origin и access_secret в локальном приватном HTTP environment.
### base_url и origin: http://awg-<имя>.localhost:<порт SSH-туннеля>.
### Секрет не сохраняйте в репозитории; cookie обрабатывается HTTP Client.

### Healthcheck без сведений о сервере
GET {{base_url}}/api/v1/health

> {%
client.test("Healthcheck", function () {
    client.assert(response.status === 200, "статус ответа на запрос не 200");
});
%}

### Вход по секрету
POST {{base_url}}/api/v1/access
Origin: {{origin}}
Content-Type: application/json

{
  "secret": "{{access_secret}}"
}

> {%
client.test("Вход", function () {
    client.assert(response.status === 200, "статус ответа на запрос не 200");
});
client.global.set("csrf_token", response.body.csrf_token);
%}

### Проверка сессии
GET {{base_url}}/api/v1/auth/me

> {%
client.test("Сессия", function () {
    client.assert(response.status === 200, "статус ответа на запрос не 200");
});
client.global.set("csrf_token", response.body.csrf_token);
%}

