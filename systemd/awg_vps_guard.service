[Unit]
Description=Restore AWG VPS egress guard before network services
DefaultDependencies=no
After=local-fs.target
Before=docker.service warp-svc.service network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
Environment=AWG_WARP_CONFIG=/etc/awg_vps_control/host.json
ExecStart=/opt/awg_vps_control/current/bin/awg_control warp guard
RemainAfterExit=true
UMask=0077

[Install]
WantedBy=multi-user.target
